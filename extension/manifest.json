{
  "manifest_version": 3,
  "name": "Aside",
  "version": "0.1.0",
  "description": "选中术语，在原页旁注专业与通俗两层解释。",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Aside 设置"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/fonts/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
