{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "globals": {
    "chrome": "readonly"
  },
  "ignorePatterns": [
    "node_modules/**",
    "extension/dist/**",
    "extension/release/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
